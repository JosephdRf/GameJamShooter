[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/end_screen.gd" id="1_end"]
[ext_resource type="Script" path="res://scripts/ui/tiled_background.gd" id="bg_tiles"]

[node name="EndScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_end")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("bg_tiles")

[node name="Margin" type="MarginContainer" parent="."]
