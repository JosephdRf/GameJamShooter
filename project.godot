; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameJamShooter"
config/description="Bubble Shooter - 2v2 en réseau local, jusqu'à 4 joueurs."
run/main_scene="res://scenes/ui/loading_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/icon.svg"

[autoload]

InputManager="*res://scripts/autoload/input_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
LanDiscovery="*res://scripts/autoload/lan_discovery.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai_mcp/plugin.cfg")

[gui]

theme/custom="res://assets/themes/ui_theme.tres"

[input_devices]

buffering/agile_event_flushing=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
